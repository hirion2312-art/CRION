{
  "name": "crion",
  "productName": "CRION",
  "version": "1.0.0",
  "description": "히리온 작품 전용 크랙 클라이언트",
  "author": "히리온",
  "license": "UNLICENSED",
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test/store.test.js && node test/packs.test.js && node test/dev.test.js && node test/community.test.js && node test/updater.test.js && node test/academy.test.js && node test/safehouse.test.js && node test/cloud.test.js && node test/home.test.js && node test/sync.test.js && node test/univ.test.js && node test/maou.test.js",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist": "electron-builder",
    "setup": "node scripts/setup-electron.js",
    "keygen": "node scripts/keygen.js",
    "registry": "node scripts/make-registry.js"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.hirion.crion",
    "productName": "CRION",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "config/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CRION",
      "artifactName": "CRION-Setup.${ext}",
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.entertainment",
      "icon": "build/icon.png",
      "identity": null
    },
    "dmg": {
      "artifactName": "CRION-mac-${arch}.${ext}"
    },
    "afterPack": "scripts/adhoc-sign.js"
  }
}
